<Window x:Class="KuaiShouApiTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KuaiShouApiTest"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" MinHeight="600" Width="800" MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*" MinHeight="100"/>
            <RowDefinition Height="2*" MinHeight="100"/>
            <RowDefinition Height="2*" MinHeight="100"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">配置</TextBlock>
        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">接口</TextBlock>
        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">入参</TextBlock>
        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">请求</TextBlock>
        <TextBlock Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">返回</TextBlock>
        <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">出参</TextBlock>

        <Grid Grid.Column="1" Grid.Row="0"  Margin="10 10 10 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="Txt_Config" Text="{Binding ApiConfig}" AcceptsReturn="True"  TextWrapping="Wrap"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Width="Auto" HorizontalAlignment="Stretch" />
            <Grid Grid.Column="1" Margin="10 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" Height="36" Width="80" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Click="Btn_Refsh_Click">刷新</Button>
                <Button Grid.Row="1" Height="36" Width="80" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Click="Btn_Save_Click">保存</Button>
            </Grid>
        </Grid>

        <ComboBox Grid.Column="1" Grid.Row="1" Name="Com_Api" ItemsSource="{Binding ApiModels}" DisplayMemberPath="DisplayName" SelectedIndex="0"  Height="36" Margin="10" VerticalContentAlignment="Center" SelectionChanged="Com_Api_SelectionChanged"/>

        <TextBox Grid.Column="1" Grid.Row="2" Name="Txt_Parm" Text="{Binding ApiParm}" AcceptsReturn="True"  TextWrapping="Wrap"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10 5"/>

        <Button Grid.Column="1" Grid.Row="3" Name="Btn_Exec" Height="36" VerticalContentAlignment="Center"  Margin="10 5" Click="Button_Click">执行</Button>

        <TextBox Grid.Column="1" Grid.Row="4" Name="Txt_Req" Text="{Binding ApiReq}" AcceptsReturn="True"  TextWrapping="Wrap"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10 5"/>
        <TextBox Grid.Column="1" Grid.Row="5" Name="Txt_Res" Text="{Binding ApiRes}" AcceptsReturn="True"  TextWrapping="Wrap"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10 5"/>
        <TextBox Grid.Column="1" Grid.Row="6" Name="Txt_Out" Text="{Binding ApiOut}" AcceptsReturn="True"  TextWrapping="Wrap"  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="10 5 10 10"/>

    </Grid>
</Window>
